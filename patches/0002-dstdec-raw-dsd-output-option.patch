--- a/libavcodec/dstdec.c
+++ b/libavcodec/dstdec.c
@@ -27,6 +27,7 @@
 
 #include "libavutil/intreadwrite.h"
 #include "libavutil/mem_internal.h"
+#include "libavutil/opt.h"
 #include "libavutil/reverse.h"
 #include "codec_internal.h"
 #include "decode.h"
@@ -68,6 +69,15 @@
 typedef struct DSTContext {
     AVClass *class;
 
+    /* Local patch: with `raw_dsd` set, the decoder stops after DST->DSD
+     * decompression and returns the raw 1-bit DSD bitstream
+     * (AV_SAMPLE_FMT_U8, MSB first, channel-interleaved) instead of running
+     * ff_dsd2pcm_translate over it. Vibenator needs the untouched DSD bits to
+     * build DoP frames for bit-perfect playback; the float PCM the stock
+     * decoder returns has already been low-pass filtered and cannot be used
+     * for that. DST->DSD is itself lossless, so the raw output is bit-exact. */
+    int raw_dsd;
+
     GetBitContext gb;
     ArithCoder ac;
     Table fsets, probs;
@@ -96,7 +106,7 @@
         return AVERROR_PATCHWELCOME;
     }
 
-    avctx->sample_fmt = AV_SAMPLE_FMT_FLT;
+    avctx->sample_fmt = s->raw_dsd ? AV_SAMPLE_FMT_U8 : AV_SAMPLE_FMT_FLT;
 
     for (i = 0; i < avctx->ch_layout.nb_channels; i++)
         memset(s->dsdctx[i].buf, 0x69, sizeof(s->dsdctx[i].buf));
@@ -251,6 +261,7 @@
     DSTContext *s = avctx->priv_data;
     GetBitContext *gb = &s->gb;
     ArithCoder *ac = &s->ac;
+    const int stride = s->raw_dsd ? 1 : 4;
     uint8_t *dsd;
     float *pcm;
     int ret;
@@ -336,7 +347,7 @@
         return ret;
 
     memset(s->status, 0xAA, sizeof(s->status));
-    memset(dsd, 0, frame->nb_samples * 4 * channels);
+    memset(dsd, 0, frame->nb_samples * stride * channels);
 
     ac_get(ac, gb, prob_dst_x_bit(s->fsets.coeff[0][0]), &dst_x_bit);
 
@@ -364,7 +375,7 @@
 
             ac_get(ac, gb, prob, &residual);
             v = ((predict >> 15) ^ residual) & 1;
-            dsd[((i >> 3) * channels + ch) << 2] |= v << (7 - (i & 0x7 ));
+            dsd[((i >> 3) * channels + ch) * stride] |= v << (7 - (i & 0x7 ));
 
             AV_WL64A(status + 8, (AV_RL64A(status + 8) << 1) | ((AV_RL64A(status) >> 63) & 1));
             AV_WL64A(status, (AV_RL64A(status) << 1) | v);
@@ -372,10 +383,12 @@
     }
 
 dsd:
-    for (i = 0; i < channels; i++) {
-        ff_dsd2pcm_translate(&s->dsdctx[i], frame->nb_samples, 0,
-                             frame->data[0] + i * 4,
-                             channels * 4, pcm + i, channels);
+    if (!s->raw_dsd) {
+        for (i = 0; i < channels; i++) {
+            ff_dsd2pcm_translate(&s->dsdctx[i], frame->nb_samples, 0,
+                                 frame->data[0] + i * 4,
+                                 channels * 4, pcm + i, channels);
+        }
     }
 
     *got_frame_ptr = 1;
@@ -383,15 +396,32 @@
     return avpkt->size;
 }
 
+#define OFFSET(x) offsetof(DSTContext, x)
+#define DEC (AV_OPT_FLAG_AUDIO_PARAM | AV_OPT_FLAG_DECODING_PARAM)
+static const AVOption dst_options[] = {
+    { "raw_dsd", "return the raw DSD bitstream instead of converting it to PCM",
+      OFFSET(raw_dsd), AV_OPT_TYPE_BOOL, { .i64 = 0 }, 0, 1, DEC },
+    { NULL },
+};
+
+static const AVClass dst_decoder_class = {
+    .class_name = "DST decoder",
+    .item_name  = av_default_item_name,
+    .option     = dst_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
 const FFCodec ff_dst_decoder = {
     .p.name         = "dst",
     CODEC_LONG_NAME("DST (Digital Stream Transfer)"),
     .p.type         = AVMEDIA_TYPE_AUDIO,
     .p.id           = AV_CODEC_ID_DST,
+    .p.priv_class   = &dst_decoder_class,
     .priv_data_size = sizeof(DSTContext),
     .init           = decode_init,
     FF_CODEC_DECODE_CB(decode_frame),
     .p.capabilities = AV_CODEC_CAP_DR1,
     .p.sample_fmts  = (const enum AVSampleFormat[]) { AV_SAMPLE_FMT_FLT,
+                                                      AV_SAMPLE_FMT_U8,
                                                       AV_SAMPLE_FMT_NONE },
 };
